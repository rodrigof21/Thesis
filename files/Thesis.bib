@article{gudeProposalGeneralIdentification2022,
  title = {Proposal of a {{General Identification Method}} for {{Fractional-Order Processes Based}} on the {{Process Reaction Curve}}},
  author = {Gude, Juan J. and Garc{\'i}a Bringas, Pablo},
